{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build solitaire.exe (MSVC)",
            "type": "shell",
			"command": "cmd.exe /c \"\"C:\\Program Files\\Microsoft Visual Studio\\2022a\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat\" && set WindowsSDKVersion=10.0.22621.0 && cl /std:c++17 /EHsc /Zi /Fe:solitaire.exe Solitaire.cpp initialize.cpp database.cpp sqlite3.c /link /DEBUG\"",
			"options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        }
    ]
}
